<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="crdroid"
           fetch="https://github.com/"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/15.0" />

  <remote  name="crdroid-gitlab"
           fetch="https://gitlab.com/"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/15.0" />

  <!-- crDroid additions -->
  <project path="android" name="crdroidx/android" remote="crdroid" />

  <project path="bootable/recovery" name="crdroidx/android_bootable_recovery" groups="pdk" remote="crdroid" />

  <project path="build/make" name="crdroidx/android_build" groups="pdk,sysui-studio" remote="crdroid" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <project path="build/soong" name="crdroidx/android_build_soong" groups="pdk,tradefed,sysui-studio" remote="crdroid" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <project path="frameworks/base" name="crdroidx/android_frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="crdroid" />

  <project path="packages/apps/Settings" name="crdroidx/android_packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc" remote="crdroid" />

</manifest>
